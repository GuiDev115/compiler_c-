int main() {
    int local_var;
    float result;
    
    local_var = 42;
    result = 3.14;
    
    array_test[0] = result;
    
    if (local_var > 0) {
        result = local_var + 10;
    } else {
        result = 0;
    }
    
    while (local_var > 0) {
        local_var = local_var - 1;
    }
    
    return 0;
}

int soma(int a, int b) {
