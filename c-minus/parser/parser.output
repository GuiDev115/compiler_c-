Terminals unused in grammar

    MOD_OP
    DOT
    INVALID_IDENTIFIER
    LEXICAL_ERROR
    ERROR_RECOVERY


Grammar

    0 $accept: programa $end

    1 programa: declaracao_lista

    2 declaracao_lista: declaracao
    3                 | declaracao_lista declaracao

    4 declaracao: var_declaracao
    5           | fun_declaracao

    6 var_declaracao: tipo_especificador IDENTIFIER SEMICOLON
    7               | tipo_especificador IDENTIFIER OPEN_BRACKET INT_NUMBER CLOSE_BRACKET arranjo_dimensao SEMICOLON
    8               | tipo_especificador IDENTIFIER error SEMICOLON
    9               | tipo_especificador IDENTIFIER OPEN_BRACKET INT_NUMBER error SEMICOLON
   10               | tipo_especificador IDENTIFIER OPEN_BRACKET error CLOSE_BRACKET SEMICOLON

   11 arranjo_dimensao: ε
   12                 | arranjo_dimensao OPEN_BRACKET INT_NUMBER CLOSE_BRACKET
   13                 | arranjo_dimensao OPEN_BRACKET INT_NUMBER error
   14                 | arranjo_dimensao OPEN_BRACKET error CLOSE_BRACKET

   15 tipo_especificador: INT_TYPE
   16                   | FLOAT_TYPE
   17                   | CHAR_TYPE
   18                   | VOID_TYPE
   19                   | STRUCT_TYPE IDENTIFIER OPEN_BRACE atributos_declaracao CLOSE_BRACE
   20                   | STRUCT_TYPE IDENTIFIER OPEN_BRACE atributos_declaracao error
   21                   | STRUCT_TYPE IDENTIFIER OPEN_BRACE error CLOSE_BRACE

   22 atributos_declaracao: var_declaracao
   23                     | atributos_declaracao var_declaracao

   24 fun_declaracao: tipo_especificador IDENTIFIER OPEN_PAREN params CLOSE_PAREN composto_decl
   25               | tipo_especificador IDENTIFIER OPEN_PAREN params error composto_decl
   26               | tipo_especificador IDENTIFIER OPEN_PAREN error CLOSE_PAREN composto_decl

   27 params: param_lista
   28       | VOID_TYPE

   29 param_lista: param
   30            | param_lista COMMA param

   31 param: tipo_especificador IDENTIFIER
   32      | tipo_especificador IDENTIFIER OPEN_BRACKET CLOSE_BRACKET
   33      | tipo_especificador IDENTIFIER OPEN_BRACKET error

   34 composto_decl: OPEN_BRACE local_declaracoes comando_lista temp

   35 temp: CLOSE_BRACE
   36     | error

   37 local_declaracoes: ε
   38                  | local_declaracoes var_declaracao

   39 comando_lista: ε
   40              | comando_lista comando

   41 comando: expressao_decl
   42        | composto_decl
   43        | selecao_decl
   44        | iteracao_decl
   45        | retorno_decl

   46 expressao_decl: expressao SEMICOLON
   47               | SEMICOLON
   48               | expressao error

   49 selecao_decl: IF_KEYWORD OPEN_PAREN expressao CLOSE_PAREN comando
   50             | IF_KEYWORD OPEN_PAREN expressao CLOSE_PAREN comando ELSE_KEYWORD comando
   51             | IF_KEYWORD OPEN_PAREN expressao error comando
   52             | IF_KEYWORD OPEN_PAREN error CLOSE_PAREN comando
   53             | IF_KEYWORD error

   54 iteracao_decl: WHILE_KEYWORD OPEN_PAREN expressao CLOSE_PAREN comando
   55              | WHILE_KEYWORD OPEN_PAREN expressao error comando
   56              | WHILE_KEYWORD OPEN_PAREN error CLOSE_PAREN comando
   57              | WHILE_KEYWORD error

   58 retorno_decl: RETURN_KEYWORD SEMICOLON
   59             | RETURN_KEYWORD expressao SEMICOLON
   60             | RETURN_KEYWORD expressao error

   61 expressao: var ASSIGN_OP expressao
   62          | expressao_simples

   63 var: IDENTIFIER
   64    | IDENTIFIER OPEN_BRACKET expressao CLOSE_BRACKET arranjo_acesso
   65    | IDENTIFIER OPEN_BRACKET expressao error arranjo_acesso
   66    | IDENTIFIER OPEN_BRACKET error CLOSE_BRACKET arranjo_acesso

   67 arranjo_acesso: ε
   68               | arranjo_acesso OPEN_BRACKET expressao CLOSE_BRACKET
   69               | arranjo_acesso OPEN_BRACKET expressao error
   70               | arranjo_acesso OPEN_BRACKET error CLOSE_BRACKET

   71 expressao_simples: expressao_soma
   72                  | expressao_soma relacional expressao_soma

   73 relacional: LE_OP
   74           | LT_OP
   75           | GT_OP
   76           | GE_OP
   77           | EQUAL_OP
   78           | NE_OP

   79 expressao_soma: termo
   80               | expressao_soma soma_op termo

   81 soma_op: PLUS_OP
   82        | MINUS_OP

   83 termo: fator
   84      | termo mult_op fator

   85 mult_op: MULT_OP
   86        | DIV_OP

   87 fator: OPEN_PAREN expressao CLOSE_PAREN
   88      | var
   89      | ativacao
   90      | REAL_NUMBER
   91      | INT_NUMBER
   92      | OPEN_PAREN expressao error
   93      | OPEN_PAREN error CLOSE_PAREN

   94 ativacao: IDENTIFIER OPEN_PAREN args CLOSE_PAREN
   95         | IDENTIFIER OPEN_PAREN args error

   96 args: ε
   97     | arg_lista

   98 arg_lista: expressao
   99          | arg_lista COMMA expressao


